# Copy to .env and adjust. .env is gitignored — never commit it.
#
# Loaded automatically by `npm start` (Node's --env-file-if-exists). Real
# environment variables take precedence over anything set here, so a value
# exported in your shell or injected by an orchestrator wins.

# Listening port.
PORT=3000

# vsearch batch search server.
VSEARCH_URL=http://127.0.0.1:8000/search/batch

# Timeout for one vsearch request (one chunk), in milliseconds. Timeouts are
# not retried, so allow for a request waiting behind others on a busy replica.
VSEARCH_TIMEOUT_MS=120000

# Large searches are split into chunks of this many sequences, and at most
# VSEARCH_CONCURRENCY chunks are in flight from this process — about twice
# the number of vsearch replicas. Chunks failing with a network error or 5xx
# are retried VSEARCH_RETRIES times.
VSEARCH_BATCH_SIZE=25
VSEARCH_CONCURRENCY=4
VSEARCH_RETRIES=2

# Cache backend for match results, keyed by nucleotideSequenceID:
#   dragonfly  Redis-compatible, expects Dragonfly on localhost:6379 (default)
#   hbase      Apache HBase over Thrift
#   none       no cache; every query goes straight to vsearch
# Read once at startup, so it cannot be changed while the server is running.
# Host/port/table for dragonfly and hbase are set in caches/config.js, not here.
CACHE=dragonfly

# Version of the reference database and vsearch parameters. Part of every cache
# key: bump it when the .udb is rebuilt or the vsearch flags change.
REFERENCE_DB_VERSION=unversioned
