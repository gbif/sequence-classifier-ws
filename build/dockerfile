ARG REG=docker.io/library

FROM $REG/node:26-alpine AS base

WORKDIR /app

# Copy manifests first so this layer is cached
COPY package*.json ./
# Copy source
COPY caches ./caches
COPY *.mjs .
COPY scripts ./scripts

# ---- Test the app ----
FROM base AS test
ENV NODE_ENV=dev
# Copy manifests first so this layer is cached
COPY test ./test
# Copy source
COPY test-data ./test-data
RUN npm test

# ---- Install dependencies the app ----
FROM base
ENV NODE_ENV=production
WORKDIR /app
RUN npm ci && npm prune
# use non-root user
USER node

EXPOSE 3000
# Run node directly so it is PID 1 and receives SIGTERM; through npm the signal
# never reaches the graceful-shutdown handler.
CMD ["node", "index.mjs"]