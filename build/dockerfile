ARG REG=docker.io/library

FROM $REG/node:26-alpine AS base

WORKDIR /app

# Copy manifests first so the dependency layer is cached
COPY package*.json ./
# Installed here so both the test stage and the final image have them; the
# tests import runtime dependencies (e.g. p-queue).
RUN npm ci
# Copy source
COPY caches ./caches
COPY *.mjs .
COPY scripts ./scripts

# ---- Test the app ----
FROM base AS test
ENV NODE_ENV=dev
COPY test ./test
COPY test-data ./test-data
RUN npm test

# ---- Final image ----
FROM base
ENV NODE_ENV=production
WORKDIR /app
RUN npm prune --omit=dev
# use non-root user
USER node

EXPOSE 3000
# Run node directly so it is PID 1 and receives SIGTERM; through npm the signal
# never reaches the graceful-shutdown handler.
CMD ["node", "index.mjs"]